                "<application android:usesCleartextTraffic=\"true\" android:extractNativeLibs=\"true\""
              );
              fs.writeFileSync(manifestPath, m, "utf8");
            }
          '

      - name: Build Unstripped Universal Release APK & Digitally Sign with apksigner
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleRelease --stacktrace --no-daemon

          # 1. Auto-generate standard Debug Keystore using JDK keytool
          rm -f debug-signing.keystore
          keytool -genkeypair -v \
            -keystore debug-signing.keystore \
            -storepass android \
            -alias androiddebugkey \
            -keypass android \
            -keyalg RSA \
            -keysize 2048 \
            -validity 10000 \
            -dname "CN=Android Debug,O=Android,C=US"

          # 2. Locate zipalign and apksigner from Android SDK build-tools
          BUILD_TOOLS_DIR=$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -n 1)
          ZIPALIGN="$BUILD_TOOLS_DIR/zipalign"
          APKSIGNER="$BUILD_TOOLS_DIR/apksigner"

          # 3. Find the built release APK and zipalign it
          RAW_APK=$(find app/build/outputs/apk/release -name "*.apk" | head -n 1)
          "$ZIPALIGN" -p -f -v 4 "$RAW_APK" aligned-universal.apk

          # 4. Digitally sign with apksigner (v1 + v2 + v3 schemes enabled) into single SahojDokan-Signed-Universal.apk
          mkdir -p signed-output
          "$APKSIGNER" sign \
            --ks debug-signing.keystore \
            --ks-key-alias androiddebugkey \
            --ks-pass pass:android \
            --key-pass pass:android \
            --v1-signing-enabled true \
            --v2-signing-enabled true \
            --v3-signing-enabled true \
            --out signed-output/SahojDokan-Signed-Universal.apk \
            aligned-universal.apk

          # 5. Verify signature
          "$APKSIGNER" verify --verbose signed-output/SahojDokan-Signed-Universal.apk

      - name: Upload Single Signed Universal APK
        uses: actions/upload-artifact@v4
        with:
          name: SahojDokan-Signed-Universal-APK
          path: android/signed-output/SahojDokan-Signed-Universal.apk
