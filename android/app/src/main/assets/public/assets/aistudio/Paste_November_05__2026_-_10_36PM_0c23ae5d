              convert "$ICON_SRC" -resize "${sz}x${sz}" "$dir/ic_launcher.png"
              convert "$ICON_SRC" -resize "${sz}x${sz}" "$dir/ic_launcher_round.png"
              convert "$ICON_SRC" -resize "${sz}x${sz}" "$dir/ic_launcher_foreground.png"
            done
